{
  "name": "bonfire",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "test": "npm test --workspaces --if-present",
    "simulate": "npm run report -w @bonfire/simulator",
    "testnet": "node --disable-warning=ExperimentalWarning scripts/testnet.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
